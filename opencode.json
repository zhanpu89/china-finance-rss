{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "pipeline-orchestrator",
  "instructions": [
    ".opencode/rules/precise-location.md",
    ".opencode/rules/endpoint-lock.md",
    ".opencode/rules/json-write-safety.md",
    ".opencode/rules/code-discipline.md",
    ".opencode/rules/doc-alignment.md",
    ".opencode/rules/arch-thinking.md",
    ".opencode/rules/project-mirror.md"
  ],
  "agent": {
    "explore": {
      "description": "只读探索：搜索/定位/理解代码，禁止任何写入",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "general": {
      "description": "通用研究执行：只读与分析，禁止任何写入与 bash 执行",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "ask"
      }
    },
    "prd-writer": {
      "description": "需求分析与 PRD 文档撰写",
      "mode": "subagent",
      "permission": {
        "edit": { "*": "deny", "doc/prd/**": "allow" },
        "write": { "*": "deny", "doc/prd/**": "allow" },
        "bash": "deny"
      },
      "prompt": "{file:.opencode/skills/prd-writer/SKILL.md}"
    },
    "review-expert": {
      "description": "全流程评审专家，对文档进行结构化评审",
      "mode": "subagent",
      "permission": {
        "edit": { "*": "deny", "doc/review/**": "allow" },
        "write": { "*": "deny", "doc/review/**": "allow" },
        "bash": "deny"
      },
      "prompt": "{file:.opencode/skills/review-expert/SKILL.md}"
    },
    "system-architect": {
      "description": "系统架构设计，将 PRD 转化为架构建档",
      "mode": "subagent",
      "permission": {
        "edit": { "*": "deny", "doc/arch/**": "allow", "tech-stack.json": "allow" },
        "write": { "*": "deny", "doc/arch/**": "allow", "tech-stack.json": "allow" },
        "bash": "deny"
      },
      "prompt": "{file:.opencode/skills/system-architect/SKILL.md}"
    },
    "task-decomposer": {
      "description": "软件模块详细设计，将 SAD 拆解为模块级详设",
      "mode": "subagent",
      "permission": {
        "edit": { "*": "deny", "doc/detailed/**": "allow" },
        "write": { "*": "deny", "doc/detailed/**": "allow" },
        "bash": "deny"
      },
      "prompt": "{file:.opencode/skills/task-decomposer/SKILL.md}"
    },
    "code-developer": {
      "description": "编码实现，精确到位 + doc-sync 标记输出",
      "mode": "subagent",
      "permission": {
        "edit": {
          "*": "deny",
          "china_finance_rss/**": "allow",
          "Dockerfile": "allow",
          "docker-compose.yml": "allow",
          "doc/deploy/**": "allow",
          "tests/**": "allow"
        },
        "write": {
          "*": "deny",
          "china_finance_rss/**": "allow",
          "tests/**": "allow",
          "Dockerfile": "allow",
          "docker-compose.yml": "allow",
          "doc/deploy/**": "allow"
        },
        "bash": {
          "python -m py_compile": "allow",
          "python -m unittest": "allow",
          "git diff": "allow",
          "git status": "allow",
          "git log": "allow",
          "*": "deny"
        }
      },
      "prompt": "{file:.opencode/skills/code-developer/SKILL.md}"
    },
    "code-reviewer": {
      "description": "代码质量门禁，评审代码并输出结构化报告",
      "mode": "subagent",
      "permission": {
        "edit": { "*": "deny", "doc/review/**": "allow", "doc/tester/drift-report.md": "allow" },
        "write": { "*": "deny", "doc/review/**": "allow", "doc/tester/drift-report.md": "allow" },
        "bash": "deny"
      },
      "prompt": "{file:.opencode/skills/code-reviewer/SKILL.md}"
    },
    "tester": {
      "description": "两阶段测试：测试用例设计 + 测试代码生成执行",
      "mode": "subagent",
      "permission": {
        "edit": {
          "*": "deny",
          "doc/tester/**": "allow",
          "tests/**": "allow"
        },
        "write": {
          "*": "deny",
          "doc/tester/**": "allow",
          "tests/**": "allow"
        },
        "bash": "allow"
      },
      "prompt": "{file:.opencode/skills/tester/SKILL.md}"
    },
    "self-evolve": {
      "description": "半自动工具自我进化，分析历史调用日志后输出改进建议",
      "mode": "subagent",
      "permission": {
        "edit": { "*": "deny", ".opencode/skills/**": "allow", ".opencode/rules/**": "allow", ".opencode/scripts/log-skill.sh": "allow", ".opencode/scripts/log-feedback.sh": "allow" },
        "write": { "*": "deny", ".opencode/skills/**": "allow", ".opencode/rules/**": "allow", ".opencode/scripts/log-skill.sh": "allow", ".opencode/scripts/log-feedback.sh": "allow" },
        "bash": "allow"
      },
      "prompt": "{file:.opencode/skills/self-evolve/SKILL.md}"
    },
    "pipeline-orchestrator": {
      "description": "全流程软件工程编排器（主 agent 模式）",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "_MEMORY_CACHE.md": "allow",
          ".opencode/project/**": "allow",
          "doc/review/**": "allow",
          "doc/tester/**": "allow"
        },
        "write": {
          "*": "deny",
          "_MEMORY_CACHE.md": "allow",
          ".opencode/project/**": "allow",
          "doc/review/**": "allow",
          "doc/tester/**": "allow"
        },
        "bash": {
          "git status": "allow",
          "git log": "allow",
          "git diff": "allow",
          "git diff --stat": "allow",
          "git diff --check": "allow",
          "git fetch": "allow",
          "git pull": "allow",
          "git push": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git branch *": "allow",
          "git checkout *": "allow",
          "git stash *": "allow",
          "git remote *": "allow",
          "git mv *": "allow",
          "git reset *": "allow",
          "git rm *": "allow",
          "git tag *": "allow",
          "git show *": "allow",
          "git rebase *": "allow",
          "git cherry-pick *": "allow",
          ".opencode/scripts/check-*.sh": "allow",
          ".opencode/scripts/mirror-log.sh": "allow",
          ".opencode/scripts/project-init.sh": "allow",
          ".opencode/scripts/log-*.sh": "allow",
          "curl *": "allow",
          "*": "deny"
        },
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "allow",
        "skill": "allow",
        "question": "allow",
        "webfetch": "ask"
      },
      "prompt": "你是 Pipeline Orchestrator — 有自主思考能力和动态计划调整能力的全流程软件工程编排器。读取 .opencode/skills/pipeline-orchestrator/SKILL.md 并执行。核心工作方式：每个 Phase 前后执行 OODA 循环（观察→判断→决策→行动→反思），主动评估情境后自主推进。初始流程强度只是起点，执行中根据实际情况可升档或降档。定期做中段反思确认轨迹正确。ai_memory 在每个关键决策点调用记录，中间产物及时丢弃。"
    }
  }
}
